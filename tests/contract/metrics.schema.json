{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "concierge.metrics",
  "title": "concierge.metrics (spec §6): one turn's latency and tokens; every key present, null when 1.8 didn't report it",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "turn", "eou_ms", "stt_ms", "llm_ttft_ms", "tts_ttfb_ms", "total_ms", "memory_on_turn_path_ms", "preload_ms",
    "extraction_ms", "prompt_tokens", "cached_tokens", "compacted"
  ],
  "properties": {
    "turn": {"type": "integer", "minimum": 1},
    "eou_ms": {"type": ["number", "null"], "minimum": 0},
    "stt_ms": {"type": ["number", "null"], "minimum": 0},
    "llm_ttft_ms": {"type": ["number", "null"], "minimum": 0},
    "tts_ttfb_ms": {"type": ["number", "null"], "minimum": 0},
    "total_ms": {"type": ["number", "null"], "minimum": 0},
    "memory_on_turn_path_ms": {"type": ["number", "null"], "minimum": 0},
    "preload_ms": {"type": ["number", "null"], "minimum": 0},
    "extraction_ms": {"type": ["number", "null"], "minimum": 0},
    "prompt_tokens": {"type": ["integer", "null"], "minimum": 0},
    "cached_tokens": {"type": ["integer", "null"], "minimum": 0},
    "compacted": {"type": "boolean"}
  }
}

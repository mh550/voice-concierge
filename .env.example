# Copy to ~/.config/voice-concierge/env (outside the repo, chmod 600). Never commit real values.
# Plain NAME=value lines only: no quotes, spaces or `$` in values (systemd and bash both read this file).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
ANTHROPIC_API_KEY=
# Optional: only with CONCIERGE_LLM_PROVIDER=openrouter.
OPENROUTER_API_KEY=
# Optional: only with CONCIERGE_SPEECH=deepgram (when the LiveKit Inference credit runs out).
DEEPGRAM_API_KEY=
# Optional switches (uncomment the NAME=value line to use; comments stay on their own lines):
# Route the LLM through OpenRouter instead of Anthropic.
# CONCIERGE_LLM_PROVIDER=openrouter
# Deepgram STT/TTS plugins instead of LiveKit Inference.
# CONCIERGE_SPEECH=deepgram
# Send visitor audio to LiveKit; for Michael's own test sessions only (B11).
# CONCIERGE_RECORD_AUDIO=1
# Kill switch: decline every job (or `touch ~/.voice-concierge-off`).
# CONCIERGE_ENABLED=0

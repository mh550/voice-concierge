# Copy to ~/.config/voice-concierge/env (outside the repo, chmod 600). Never commit real values.
# Plain NAME=value lines only: no quotes, spaces or `$` in values (systemd and bash both read this file).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
ANTHROPIC_API_KEY=
# Optional: only with CONCIERGE_LLM_PROVIDER=openrouter.
OPENROUTER_API_KEY=
# Optional: only with CONCIERGE_SPEECH=deepgram (when the LiveKit Inference credit runs out).
DEEPGRAM_API_KEY=
# Optional switches (uncomment to use):
# CONCIERGE_LLM_PROVIDER=openrouter  # route the LLM through OpenRouter instead of Anthropic
# CONCIERGE_SPEECH=deepgram          # Deepgram STT/TTS plugins instead of LiveKit Inference
# CONCIERGE_RECORD_AUDIO=1           # send visitor audio to LiveKit; for Michael's own test sessions only (B11)
# CONCIERGE_ENABLED=0                # kill switch: decline every job (or `touch ~/.voice-concierge-off`)
